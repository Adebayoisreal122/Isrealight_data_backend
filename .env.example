NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Must be Atlas or a replica set (wallet logic uses MongoDB transactions)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/vtu
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# VTpass (sandbox first; switch to https://vtpass.com/api for live)
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# Paystack (wallet funding)
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/wallet/verify

# Default markups applied when syncing plans
DEFAULT_MARKUP_PERCENT=3
DEFAULT_AGENT_MARKUP_PERCENT=1.5

# For `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
